{
  "appId": "com.ytmusicplayer.app",
  "appName": "YT Music Player",
  "webDir": "out/web",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "*.youtube.com",
      "*.ytimg.com",
      "*.ggpht.com",
      "*.google.com",
      "*.googlevideo.com"
    ]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
