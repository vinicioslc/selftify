{
  "name": "selftify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A cross-platform music player with Navidrome, Jellyfin, YouTube Music, and local file support",
  "license": "GPL-3.0",
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server/scripts/ensure-better-sqlite3.mjs && npm run dev --workspace=server",
    "build": "vite build",
    "build:server": "npm run build --workspace=server",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "duplicate": "jscpd src/ -f ts,tsx --min-lines 10 --min-tokens 50",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fetch": "vitest run --config vitest.fetch.config.ts",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "test:integration:ui": "playwright test --config tests/integration/playwright.config.ts --ui",
    "test:server-api": "playwright test --config tests/int/playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.0.0",
    "audiomotion-analyzer": "^4.0.0",
    "butterchurn": "^2.0.0",
    "butterchurn-presets": "^2.0.0",
    "chroma-js": "^3.0.0",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.0",
    "fuse.js": "^7.0.0",
    "immer": "^10.0.0",
    "is-electron": "^2.2.2",
    "lodash-es": "^4.17.21",
    "music-metadata": "^11.12.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0",
    "sql.js": "^1.14.1",
    "youtubei.js": "^17.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/chroma-js": "^3.0.0",
    "@types/lodash-es": "^4.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.4.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.0",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "jscpd": "^5.0.8",
    "lucide-react": "^0.400.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.1.0"
  }
}
