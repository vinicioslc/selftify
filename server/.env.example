# Diretório raiz da biblioteca de música local.
# O banco fica em <LIBRARY_ROOT>/.selftify/library.db
# As músicas ficam em <LIBRARY_ROOT>/<track.path>
LIBRARY_ROOT=/music

# Porta do servidor HTTP
PORT=6189

# CORS: deixe vazio para permitir QUALQUER origem (sem barreira CORS, padrão dev).
# Em produção, restrinja a uma lista separada por vírgula, ex.:
# CORS_ORIGINS=https://app.selftify.local,http://localhost:5273
CORS_ORIGINS=

# Usuário/senha padrão da API Subsonic (token auth).
# Em produção, sobrescreva via env/secrets.
SUBSONIC_USER=admin
SUBSONIC_PASSWORD=admin
